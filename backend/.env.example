DATABASE_URL=sqlite+aiosqlite:///./data.db
REDIS_URL=redis://localhost:6379
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
STORAGE_DIR=./storage
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SCRIPT_GEN_RETRIES=3
MAX_UPLOAD_MB=10
SUBTITLE_BURN_DEFAULT=false
# Opcionales: claves de Google AI Studio (Gemini API). La misma clave sirve para
# imágenes (Nano Banana) y video (Omni). También se pueden guardar desde la UI
# de Configuración (provider "gemini" y "omni") en lugar de usar variables.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OMNI_API_KEY=
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
# Opcional: API key de fal.ai (https://fal.ai/dashboard/keys) para imágenes y
# video. Se guarda en Configuración (provider "fal") o aquí:
# FAL_API_KEY=
# FAL_KEY=
# Opcional: API key de OpenAI para generar guiones (provider "openai" en el
# paso de guion). Se guarda en Configuración o aquí:
# OPENAI_API_KEY=
